# Local dev database (SQLite file). Swap for a Postgres connection string in production, e.g.
# DATABASE_URL="postgresql://user:password@localhost:5432/wip_tracker"
DATABASE_URL="file:./dev.db"

# Used to sign session tokens. Replace with a long random value in every real environment.
JWT_SECRET="dev-only-secret-change-me"

PORT=4000

# --- Business Central integration -------------------------------------------------
# These are read by src/services/bcClient.ts. Until they are supplied, job import
# falls back to the local fixture in server/src/services/bcFixture.json so the rest
# of the app can be developed/demoed without a live BC tenant.
BC_TENANT_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_ENVIRONMENT=production
BC_COMPANY_ID=
